<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Fluence</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>Fluence</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Fluence listens while you practise speaking. Your voice is sent to the AI during a conversation.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Fluence uses speech recognition to process your spoken practice in real-time.</string>
	<key>NSCameraUsageDescription</key>
	<string>Fluence uses the camera to scan learning materials and visual prompts for interactive conversations.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Fluence allows selecting photos and scans of textbook lessons.</string>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>FluenceManagedAccountsEnabled</key>
	<string>$(FLUENCE_MANAGED_ACCOUNTS_ENABLED)</string>
	<key>FluenceManagedAPIURL</key>
	<string>$(FLUENCE_MANAGED_API_URL)</string>
	<key>FluenceGoogleSignInEnabled</key>
	<string>$(FLUENCE_GOOGLE_SIGN_IN_ENABLED)</string>
	<key>FluenceGoogleClientID</key>
	<string>$(FLUENCE_GOOGLE_CLIENT_ID)</string>
	<key>FluenceAppleSignInEnabled</key>
	<string>$(FLUENCE_APPLE_SIGN_IN_ENABLED)</string>
	<key>FluenceAppleClientID</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Google sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(MURAL_GOOGLE_CALLBACK_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
